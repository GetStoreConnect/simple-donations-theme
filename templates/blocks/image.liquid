<div class="CB-Component" data-cb="{{ content_block.identifier }}">
  <div class="sc-image sc-border-radius sc-overflow-hidden"
       data-alignment="{{ content_block.alignment }}"
       data-alignment-target="{{ content_block.identifier }}">

    {%- unless content_block.link_target == blank %}
      <a class="sc-image_link" href="{{ content_block.link_target }}" title="{{ content_block.link_label }}">
        {%- unless content_block.image == blank %}
          <img loading="lazy"
               src="{{ content_block.image.massive_url }}"
               alt="{{ content_block.title | default: content_block.image.alt_text }}"
          />
        {%- else %}
          <svg class="SC-Placeholder" width="800" viewBox="0 0 1 1">
            <rect width="100%" height="100%"></rect>
            <circle cx="50%" cy="50%" r="20%" fill="rgba(0,0,0,0.05)"/>
          </svg>
        {%- endunless %}
        {%- unless content_block.title == blank or content_block.content == blank %}
          <div class="sc-image_caption">
            {%- if content_block.title != blank %}
              <h3>{{ content_block.title }}</h3>
            {%- endif %}

            {%- if content_block.content != blank %}
              <div>
                {{ content_block.content }}
              </div>
            {%- endif %}
          </div>
        {%- endunless %}

        {%- if content_block.content != blank or content_block.content != blank %}
          <div class="sc-image-overlay"></div>
        {%- endif %}
      </a>

    {%- else %}
      {%- unless content_block.image == blank %}
        <img loading="lazy"
              src="{{ content_block.image.massive_url }}"
              alt="{{ content_block.title | default: content_block.image.alt_text }}"
        />
      {%- else %}
        <svg class="SC-Placeholder" width="800" viewBox="0 0 1 1">
          <rect width="100%" height="100%"></rect>
          <circle cx="50%" cy="50%" r="20%" fill="rgba(0,0,0,0.05)"/>
        </svg>
      {%- endunless %}

      {%- unless content_block.title == blank or content_block.content == blank %}
        <div class="sc-image_caption">
          {%- if content_block.title != blank %}
            <h3>{{ content_block.title }}</h3>
          {%- endif %}

          {%- if content_block.content != blank %}
            <div>
              {{ content_block.content }}
            </div>
          {%- endif %}
        </div>
      {%- endunless %}

      {%- if content_block.content != blank or content_block.content != blank %}
        <div class="sc-image-overlay"></div>
      {%- endif %}
    {%- endunless %}
  </div>
</div>